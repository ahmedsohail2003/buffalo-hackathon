# Copy to .env.local for local development (git-ignored). Never commit real keys.
#
# Local dev only: Vite inlines VITE_* values into the browser bundle. Fine on your own laptop,
# never for a public deploy (use the server below instead and leave this empty).
VITE_GEMINI_API_KEY=
#
# Server (server/index.mjs) — holds the keys for the public deploy; the browser never sees them.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_MISSION=
ELEVENLABS_VOICE_COWORKER=
PORT=8787
#
# Optional server settings (defaults in brackets):
# GEMINI_LIVE_API_VERSION=v1alpha     API version the browser uses with a Live token [v1alpha]
# ALLOWED_ORIGINS=https://your.domain  refuse API POSTs from other origins [any]
# TRUST_PROXY=1                        take the client IP from X-Forwarded-For (behind Caddy) [off]
# RATE_TTS=30 RATE_GEMINI=40 RATE_LIVE_TOKEN=10   requests per IP per minute
# Server-wide budgets, all clients together (over budget: 429 budget_exhausted; the browser drops that one request):
# BUDGET_TTS_CHARS_PER_MIN=6000 BUDGET_TTS_CHARS_PER_DAY=100000    ElevenLabs characters
# BUDGET_GEMINI_PER_MIN=120 BUDGET_GEMINI_PER_DAY=5000             Gemini requests, Live tokens included
# GEMINI_BODY_CAP=1048576             largest Gemini request body, bytes [1 MiB]
# GEMINI_MAX_OUTPUT_TOKENS=32768       maxOutputTokens ceiling on every generate call (thinking included; design runs at HIGH thinking) [32768]
# GEMINI_MAX_THINKING_BUDGET=4096      ceiling for a thinkingBudget the browser sends [4096]
# HOST=0.0.0.0                         bind address [0.0.0.0]
