# Private files: git never commits or publishes these.
# See "Private files" in README.md.

# Any folder named private, at any depth
private/

# Any file with .private. in its name, such as pitch.private.md
*.private.*

# Secrets
.env
.env.*
!.env.example

# --- from emberhacks-cell .gitignore (Vite/Node) ---
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
